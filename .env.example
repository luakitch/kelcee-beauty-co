# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key from Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# gallery-dev for local testing, gallery for production
NEXT_PUBLIC_SUPABASE_GALLERY_BUCKET=gallery-dev

# Comma-separated admin emails (must match Supabase Auth users + is_gallery_admin() in schema.sql)
NEXT_PUBLIC_ADMIN_EMAILS=kitchelsoftware@gmail.com,hello@kelceebeautyco.com

# Instagram profile URL for booking button
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/kelceebeautyco
