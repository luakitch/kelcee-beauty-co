# Public site URL (no trailing slash) — must match Supabase Auth Site URL base
NEXT_PUBLIC_SITE_URL=https://kelcee-beauty-co.pages.dev

# Supabase — create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use the publishable key from Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# gallery-dev for local testing, gallery for production
NEXT_PUBLIC_SUPABASE_GALLERY_BUCKET=gallery-dev

# Comma-separated admin emails (must match Supabase Auth users + is_gallery_admin() in schema.sql)
NEXT_PUBLIC_ADMIN_EMAILS=kitchelsoftware@gmail.com,kelcee05@icloud.com,mkenzie2000@hotmail.com

# Square Appointments booking page (use clean URL without tracking params)
NEXT_PUBLIC_BOOKING_URL=https://book.squareup.com/appointments/1s5oteiurlqsjl/location/L4RM80YTMFAKH/services

# Instagram profile URL
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/kelceebeautyco
